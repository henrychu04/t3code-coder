{
  "name": "t3code-coder",
  "private": true,
  "type": "module",
  "scripts": {
    "knip": "knip",
    "knip:check": "knip --include files,dependencies --no-config-hints",
    "build": "pnpm --filter @t3tools/coder-helper build && pnpm --filter @t3tools/web build",
    "coder:live:serve": "pnpm build && node scripts/coder-live-test.mjs serve",
    "coder:live:setup": "node scripts/coder-live-test.mjs setup",
    "coder:live:status": "node scripts/coder-live-test.mjs status",
    "coder:live:stop": "node scripts/coder-live-test.mjs stop",
    "coder:live:test": "node scripts/coder-live-test.mjs test",
    "coder:pr-smoke": "pnpm --filter @t3tools/web build && node scripts/coder-pr-smoke.mjs",
    "start": "pnpm build && node apps/coder-gateway/src/bin.ts",
    "start:open": "pnpm build && node apps/coder-gateway/src/bin.ts --open-browser",
    "generate:sbom": "pnpm sbom --sbom-format cyclonedx --sbom-spec-version 1.6 --sbom-type application --lockfile-only --prod --out docs/sbom.cdx.json",
    "typecheck:gateway": "tsgo --noEmit -p apps/coder-gateway/tsconfig.json",
    "typecheck:helper": "tsgo --noEmit -p apps/coder-helper/tsconfig.json",
    "typecheck:server": "tsgo --noEmit -p apps/server/tsconfig.json",
    "typecheck:web": "tsgo --noEmit -p apps/web/tsconfig.json",
    "test:contracts": "pnpm --filter @t3tools/contracts test",
    "test:server": "vp test run --config vite.coder.config.ts",
    "test:coder": "node --test apps/coder-gateway/src/*.test.ts apps/coder-helper/src/*.test.ts packages/coder-cli/src/*.test.ts && pnpm --filter effect-codex-app-server test && pnpm test:contracts && pnpm test:server && pnpm test:client-runtime && pnpm test:shared:coder && pnpm test:web:coder",
    "test:coder:live": "node scripts/coder-live-test.mjs test",
    "test:web:coder": "pnpm --filter @t3tools/web test src/coder src/state/projectTextSearch.react.test.tsx src/promptStashStore.test.ts src/composerDraftStore.unsent.test.ts src/rightPanelStore.test.ts src/terminalUiStateStore.test.ts src/components/files src/components/diffs",
    "test:client-runtime": "pnpm --filter @t3tools/client-runtime test",
    "test:shared:coder": "vp test run packages/shared/src/imageSignature.test.ts packages/shared/src/KeyedCoalescingWorker.test.ts packages/shared/src/path.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "knip": "6.34.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.10"
  },
  "packageManager": "pnpm@11.10.0"
}
