{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": { "types": "off", "nsTypes": "off" },
  // Platform tools, not npm packages. Coder and glab remain user/workspace owned.
  "ignoreBinaries": ["coder", "glab", "git", "ssh", "scp", "nix"],
  // Upstream exports whose only consumers are surfaces this fork does not carry. The files stay
  // upstream's verbatim; drop an entry once its file no longer reports unused exports.
  "ignoreIssues": {
    "apps/server/src/attachmentStore.ts": ["exports", "nsExports"],
    "apps/server/src/auth/ServerSecretStore.ts": ["exports", "nsExports"],
    "apps/server/src/environmentTheme.ts": ["exports", "nsExports"],
    "apps/server/src/git/GitManager.ts": ["exports", "nsExports"],
    "apps/server/src/mcp/McpInvocationContext.ts": ["exports", "nsExports"],
    "apps/server/src/mcp/McpSessionRegistry.ts": ["exports", "nsExports"],
    "apps/server/src/mcp/OrchestratorMcpService.ts": ["exports", "nsExports"],
    "apps/server/src/mcp/toolkits/environment/handlers.ts": ["exports", "nsExports"],
    "apps/server/src/orchestration-v2/Adapters/ClaudeAdapterV2.testkit.ts": ["exports", "nsExports"],
    "apps/server/src/orchestration-v2/Adapters/ClaudeAdapterV2.ts": ["exports", "nsExports"],
    "apps/server/src/orchestration-v2/Adapters/PiAdapterV2.testkit.ts": ["exports", "nsExports"],
    "apps/server/src/orchestration-v2/ProviderAdapterRegistry.ts": ["exports", "nsExports"],
    "apps/server/src/orchestration-v2/ResourceCleanupService.ts": ["exports", "nsExports"],
    "apps/server/src/orchestration-v2/ThreadStream.ts": ["exports", "nsExports"],
    "apps/server/src/orchestration-v2/testkit/fixtures/claude_nested_background_subagent_wake/input.ts": ["exports", "nsExports"],
    "apps/server/src/orchestration-v2/testkit/fixtures/claude_nested_subagent_model/input.ts": ["exports", "nsExports"],
    "apps/server/src/orchestration-v2/testkit/fixtures/message_steering/input.ts": ["exports", "nsExports"],
    "apps/server/src/orchestration-v2/testkit/fixtures/shared.ts": ["exports", "nsExports"],
    "apps/server/src/os-jank.ts": ["exports", "nsExports"],
    "apps/server/src/provider/CodexProvider.ts": ["exports", "nsExports"],
    "apps/server/src/scheduledTasks/ScheduledTaskService.ts": ["exports", "nsExports"],
    "apps/server/src/serverActivation.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/connection/index.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/connection/presentation.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/connection/supervisor.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/environment/knownEnvironment.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/operations/projects.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/rpc/client.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/scheduledTaskWebhook.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/state/gitActions.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/state/models.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/state/presentation.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/state/projectGrouping.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/state/projects.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/state/runtime.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/state/shellPullRequests.ts": ["exports", "nsExports"],
    "packages/client-runtime/src/state/threadSettled.ts": ["exports", "nsExports"],
    "packages/contracts/src/auth.ts": ["exports", "nsExports"],
    "packages/contracts/src/browserProfile.ts": ["exports", "nsExports"],
    "packages/contracts/src/chatAttachment.ts": ["exports", "nsExports"],
    "packages/contracts/src/clientRpcPermissions.ts": ["exports", "nsExports"],
    "packages/contracts/src/composerContext.ts": ["exports", "nsExports"],
    "packages/contracts/src/device.ts": ["exports", "nsExports"],
    "packages/contracts/src/environment.ts": ["exports", "nsExports"],
    "packages/contracts/src/model.ts": ["exports", "nsExports"],
    "packages/contracts/src/preview.ts": ["exports", "nsExports"],
    "packages/contracts/src/previewAutomation.ts": ["exports", "nsExports"],
    "packages/contracts/src/rpc.ts": ["exports", "nsExports"],
    "packages/contracts/src/settings.ts": ["exports", "nsExports"],
    "packages/contracts/src/t3ProjectFile.ts": ["exports", "nsExports"],
    "packages/provider-core/src/server/IdAllocator.ts": ["exports", "nsExports"],
    "packages/provider-core/src/server/mcpSession.ts": ["exports", "nsExports"],
    "packages/provider-core/src/server/snapshotProbe.ts": ["exports", "nsExports"],
    "packages/provider-testing/src/fakeCli.ts": ["exports", "nsExports"],
    "packages/shared/src/HostProcess.ts": ["exports", "nsExports"],
    "packages/shared/src/composerTrigger.ts": ["exports", "nsExports"],
    "packages/shared/src/filePreview.ts": ["exports", "nsExports"],
    "packages/shared/src/hostClassification.ts": ["exports", "nsExports"],
    "packages/shared/src/htmlRender.ts": ["exports", "nsExports"],
    "packages/shared/src/imageDimensions.ts": ["exports", "nsExports"],
    "packages/shared/src/mcpApp.ts": ["exports", "nsExports"],
    "packages/shared/src/mcpResponsePayloads.ts": ["exports", "nsExports"],
    "packages/shared/src/sourceControl.ts": ["exports", "nsExports"],
    "packages/shared/src/t3McpToolPresentation.ts": ["exports", "nsExports"],
    "packages/shared/src/threadLinks.ts": ["exports", "nsExports"],
    "packages/source-control-core/src/server/SourceControlProvider.ts": ["exports", "nsExports"],
    "packages/source-control-core/src/server/SourceControlRateLimit.ts": ["exports", "nsExports"],
    "packages/source-control-gitlab/src/server/GitLabPullRequestCli.ts": ["exports", "nsExports"],
    "packages/source-control-gitlab/src/server/GitLabPullRequestProvider.ts": ["exports", "nsExports"],
    "packages/source-control-testing/src/TestSourceControlHost.ts": ["exports", "nsExports"],
  },
  "workspaces": {
    ".": {
      "project": ["*.{js,mjs,cjs,ts,mts,cts}", "scripts/**/*.{mjs,ts}"],
      "entry": ["scripts/*.mjs", "scripts/knip-schemas.ts", "vite.coder.config.ts"],
    },
    "apps/coder-gateway": { "entry": ["src/bin.ts!", "src/*.test.ts"] },
    "apps/coder-helper": { "entry": ["src/bin.ts!", "src/build.ts", "src/*.test.ts"] },
    "apps/server": {
      // The helper imports these source modules directly during bundling.
      "entry": [
        "src/coder*.ts!",
        "src/provider/testFixtures/*.mjs",
        "src/**/testing/*.fixture.{mjs,sh}",
      ],
    },
    "apps/web": { "entry": ["src/main.tsx!", "src/routes/**/*.tsx!"] },
    "packages/*": { "includeEntryExports": true },
    "packages/coder-cli": { "entry": ["src/*.test.ts"] },
    "packages/effect-codex-app-server": {
      "includeEntryExports": true,
      "entry": ["test/fixtures/*.ts"],
      // Preserve the complete generated upstream protocol.
      "ignoreIssues": { "src/_generated/**": ["exports", "types"] },
    },
  },
}
